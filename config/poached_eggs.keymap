#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    macros {
        // "00"（KP_N0 を 2 回送る）numpad 用マクロ
        num_00: num_00 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp KP_N0 &kp KP_N0>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_enter {
            bindings = <&kp RET>;
            key-positions = <42 43>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESC    &kp Q     &kp W  &kp E     &kp R     &kp T                       &kp Y  &kp U  &kp I      &kp O    &kp P     &kp LEFT_BRACKET
&kp TAB    &kp A     &kp S  &kp D     &kp F     &kp G                       &kp H  &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z     &kp X  &kp C     &kp V     &kp B                       &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
&kp LGUI   &kp LALT  &none  &kp LGUI  &kp LALT  &mo 1  &kp SPACE  &kp BSPC  &mo 2  &none  &kp RGUI   &none    &kp RALT  &tog 4
            >;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
&kp GRAVE  &kp N1  &kp N2  &kp N3          &kp N4            &kp N5                       &kp N6  &kp N7  &kp N8  &kp N9   &kp N0   &kp MINUS
&kp F1     &kp F2  &kp F3  &kp F4          &kp F5            &kp F6                       &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&none      &none   &none   &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT                   &none   &none   &none   &none    &none    &none
&none      &none   &none   &trans          &trans            &trans      &trans  &trans  &mo 3   &trans  &trans   &none    &none    &none
            >;
        };

        raise_layer {
            display-name = "Raise";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans          &kp UP_ARROW    &trans           &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans          &trans          &trans           &trans  &trans
&trans  &trans  &trans  &trans  &trans  &mo 3   &trans  &trans  &trans  &trans          &trans          &trans           &trans  &trans
            >;
        };

        bt_layer {
            display-name = "BT";
            bindings = <
&bt BT_CLR      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                &none  &none  &none  &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none                       &none  &none  &none  &none  &none  &none
&none           &none         &none         &none         &none         &none                       &none  &none  &none  &none  &none  &none
&kp O           &kp M         &kp U         &none         &none         &none         &none  &none  &none  &none  &none  &kp K  &kp E  &kp N
            >;
        };

        media_layer {
            display-name = "Media";
            bindings = <
&trans  &trans  &trans          &kp UP_ARROW    &trans           &trans                        &trans  &trans          &kp UP_ARROW    &trans           &trans  &trans
&trans  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans                        &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans  &trans
&trans  &trans  &trans          &trans          &trans           &trans                        &trans  &trans          &trans          &trans           &trans  &trans
&trans  &trans  &trans          &trans          &trans           &trans  &kp SPACE  &kp SPACE  &trans  &trans          &trans          &trans           &trans  &trans
            >;
        };
    };
};
